qt_build_snapshot() {
  local library package resolved
  local -a build_packages=(
    binutils cmake gcc gcc-libs glibc layer-shell-qt ninja nodejs npm
    qt6-base qt6-declarative qt6-shadertools qt6-svg qt6-tools qt6-wayland
    qtkeychain-qt6 syntax-highlighting wayland-protocols
  )

  {
    printf 'qt=%s\n' "$(qmake6 -query QT_VERSION)"
    for package in "${build_packages[@]}"; do
      LC_ALL=C pacman -Q "$package"
    done
    while IFS= read -r library; do
      resolved=$(readlink -f -- "$library")
      [[ $resolved == /usr/lib/* && -f $resolved ]]
      printf 'library=%s\ttarget=%s\t' "$library" "$resolved"
      sha256sum -- "$resolved"
    done < <(
      find /usr/lib -maxdepth 1 -type l \
        \( -name 'libQt6*.so.6' -o -name 'libqt6keychain.so.1' \
        -o -name 'libLayerShellQtInterface.so.6' \) \
        -print | LC_ALL=C sort
    )
    find /usr/include/qt6/QtGui -type f -print0 |
      LC_ALL=C sort -z |
      xargs -0 -r sha256sum
  } | sha256sum | cut -d' ' -f1
}

configure_npm_environment() {
  export npm_config_cache="$srcdir/npm-cache"
  export npm_config_audit=false
  export npm_config_fund=false
  export npm_config_ignore_scripts=true
  export npm_config_update_notifier=false
}

prepare() {
  cd "$srcdir/$_source_root"
  patch --forward --strip=1 --input="$srcdir/enoshima-install-paths.patch"
  patch --forward --strip=1 \
    --input="$srcdir/preserve-clipboard-mime-offers.patch"

  printf '%s  %s\n' \
    "$_npm_lock_api" src/typescript/api/package-lock.json \
    "$_npm_lock_extension_manager" src/typescript/extension-manager/package-lock.json \
    "$_npm_lock_raycast_compat" src/typescript/raycast-api-compat/package-lock.json |
    sha256sum --check --status

  /usr/bin/python - \
    src/typescript/api/package-lock.json \
    src/typescript/extension-manager/package-lock.json \
    src/typescript/raycast-api-compat/package-lock.json <<'PY'
import json
from pathlib import Path
import sys

for raw_path in sys.argv[1:]:
    path = Path(raw_path)
    lock = json.loads(path.read_text(encoding="utf-8"))
    packages = lock.get("packages")
    if not isinstance(packages, dict) or "" not in packages:
        raise SystemExit(f"{path}: package lock has no complete packages map")
    for name, package in packages.items():
        if not name or package.get("link") is True:
            continue
        resolved = package.get("resolved")
        integrity = package.get("integrity")
        if name.startswith("../"):
            # npm lockfile v3 records local workspace targets twice: the
            # node_modules entry is an explicit link and the sibling package
            # entry carries no remote URL. Accept only a normalized immediate
            # sibling that resolves below this reviewed TypeScript workspace.
            target = (path.parent / name).resolve()
            workspace = path.parents[1].resolve()
            if (
                "/" in name.removeprefix("../")
                or target.parent != workspace
                or not (target / "package.json").is_file()
                or resolved is not None
                or integrity is not None
            ):
                raise SystemExit(f"{path}: unsafe npm workspace entry: {name}")
            continue
        if isinstance(resolved, str) and resolved.startswith("file:"):
            continue
        if not (
            isinstance(resolved, str)
            and resolved.startswith("https://registry.npmjs.org/")
            and isinstance(integrity, str)
            and integrity.startswith("sha512-")
        ):
            raise SystemExit(f"{path}: unpinned npm package entry: {name}")
PY

  # Populate only npm's content-addressed cache while network access is
  # available. Lifecycle scripts stay disabled in both installation phases.
  configure_npm_environment
  local workspace
  for workspace in "${_npm_cache_workspaces[@]}"; do
    npm --prefix "$workspace" ci --ignore-scripts
  done
  npm cache verify
  for workspace in "${_npm_cache_workspaces[@]}"; do
    rm -rf -- "$workspace/node_modules"
  done
}

build() {
  export SOURCE_DATE_EPOCH=$_source_date_epoch
  configure_npm_environment
  export npm_config_offline=true

  local -a cmake_flags=(
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR:STRING=lib
    -DCMAKE_INSTALL_LIBEXECDIR=libexec
    -DCMAKE_INSTALL_DATADIR=share
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -DBUILD_TESTS=OFF
    -DLTO=OFF
    -DIGNORE_CCACHE=ON
    -DINSTALL_NODE_MODULES=ON
    -DTYPESCRIPT_EXTENSIONS=ON
    -DVICINAE_NODE_RUNTIME_DOWNLOAD=OFF
    -DQT_QML_NO_CACHEGEN=ON
    -DINSTALL_MODULES_LOAD_CONFIG=OFF
    -DUSE_SYSTEM_CMARK_GFM=OFF
    -DUSE_SYSTEM_GLAZE=OFF
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
    -DUSE_SYSTEM_KF6=ON
    -DUSE_SYSTEM_QT_KEYCHAIN=ON
    -DUSE_SYSTEM_LAYER_SHELL=ON
    -DVICINAE_GIT_TAG=v0.25.0
    -DVICINAE_GIT_COMMIT_HASH=7e13b3f54
    -DVICINAE_PROVENANCE=arch_source
  )

  qt_snapshot=$(qt_build_snapshot)
  printf '%s\n' "$qt_snapshot" >"$srcdir/qt-build-snapshot"

  cmake \
    -S "$srcdir/$_source_root" \
    -B "$srcdir/build" \
    -G Ninja \
    "${cmake_flags[@]}" \
    -DFETCHCONTENT_SOURCE_DIR_GLAZE="$srcdir/$_glaze_root"
  grep -Fxq 'CMAKE_INSTALL_LIBDIR:STRING=lib' "$srcdir/build/CMakeCache.txt"
  cmake --build "$srcdir/build" --parallel "${NINJAJOBS:-4}"
  [[ $(qt_build_snapshot) == "$qt_snapshot" ]]
}

check() {
  local elf output
  local -a executables=(
    "$srcdir/build/bin/vicinae"
    "$srcdir/build/bin/vicinae-browser-link"
    "$srcdir/build/bin/vicinae-data-control-server"
    "$srcdir/build/bin/vicinae-file-indexer"
    "$srcdir/build/bin/vicinae-input-server"
    "$srcdir/build/bin/vicinae-server"
  )

  [[ -s $srcdir/build/extension-runtime.js ]]
  grep -Fq 'qrc_vicinae-server_raw_qml_0.cpp' "$srcdir/build/build.ninja"
  ! grep -Fq '/qmlcachegen' "$srcdir/build/build.ninja"
  ! find "$srcdir/build" -type f -name '*qmlcache*.cpp' -size +0c -print -quit |
    grep -q .
  for elf in "${executables[@]}"; do
    [[ -x $elf ]]
    ! readelf -d "$elf" | grep -Eq '\((RPATH|RUNPATH)\)'
    ! readelf --wide --dyn-syms "$elf" | grep -Fq '@Qt_6_PRIVATE_API'
    output=$(LC_ALL=C ldd -r "$elf" 2>&1)
    ! grep -Eq 'not found|undefined symbol:' <<<"$output"
  done
  strings -a "$srcdir/build/bin/vicinae-server" | grep -Fxq "v$pkgver"
  strings -a "$srcdir/build/bin/vicinae-server" | grep -Fxq "$_short_commit"
  strings -a "$srcdir/build/bin/vicinae-server" | grep -Fxq arch_source
  cmake --build "$srcdir/build" --target vicinae-clipboard-mime-tests
  "$srcdir/build/bin/vicinae-clipboard-mime-tests"
  desktop-file-validate "$srcdir/vicinae.desktop" "$srcdir/vicinae-url-handler.desktop"
}

package() {
  local elf needed resolved qt_version package_name package_version
  local build_id interpreter library_hash mode packages_json libraries_json
  local executables_json needed_json qt_snapshot relative
  local -a executables qt_libraries build_packages cmake_flags
  local -a needed_libraries
  local -a manifest_arguments upstream_payload expected_upstream_payload

  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  # The upstream source is patched to make DESTDIR safe. Restrict its install
  # rules to the six reviewed executables, packaged service, icon, desktops,
  # and 31 themes before adding Enoshima policy files below.
  mapfile -t upstream_payload < <(
    find "$pkgdir/usr" -type f -printf '%P\n' | LC_ALL=C sort
  )
  mapfile -t expected_upstream_payload < <(
    {
      printf '%s\n' \
        bin/vicinae \
        libexec/vicinae/vicinae-browser-link \
        libexec/vicinae/vicinae-data-control-server \
        libexec/vicinae/vicinae-file-indexer \
        libexec/vicinae/vicinae-input-server \
        libexec/vicinae/vicinae-server \
        lib/systemd/user/vicinae.service \
        share/applications/vicinae-url-handler.desktop \
        share/applications/vicinae.desktop \
        share/icons/hicolor/512x512/apps/vicinae.png
      find "$srcdir/$_source_root/extra/themes" -type f \
        -printf 'share/vicinae/themes/%P\n'
    } | LC_ALL=C sort
  )
  [[ ${upstream_payload[*]} == "${expected_upstream_payload[*]}" ]]

  install -Dm644 vicinae.desktop vicinae-url-handler.desktop \
    -t "$pkgdir/usr/share/applications"
  install -Dm644 20-enoshima-qt-compatibility.conf \
    "$pkgdir/usr/lib/systemd/user/vicinae.service.d/20-enoshima-qt-compatibility.conf"
  install -Dm644 \
    40-vicinae-qt-pre.hook \
    40-vicinae-qt-post.hook \
    41-vicinae-package-pre.hook \
    vicinae.hook \
    -t "$pkgdir/usr/share/libalpm/hooks"
  install -Dm755 vicinae-build-compatible vicinae-qt-guard \
    -t "$pkgdir/usr/libexec/vicinae"

  executables=(
    "$pkgdir/usr/bin/vicinae"
    "$pkgdir/usr/libexec/vicinae/vicinae-browser-link"
    "$pkgdir/usr/libexec/vicinae/vicinae-data-control-server"
    "$pkgdir/usr/libexec/vicinae/vicinae-file-indexer"
    "$pkgdir/usr/libexec/vicinae/vicinae-input-server"
    "$pkgdir/usr/libexec/vicinae/vicinae-server"
  )
  qt_snapshot=$(<"$srcdir/qt-build-snapshot")
  [[ $qt_snapshot =~ ^[0-9a-f]{64}$ ]]
  [[ $(qt_build_snapshot) == "$qt_snapshot" ]]
  mapfile -t qt_libraries < <(
    for elf in "${executables[@]}"; do
      readelf -d "$elf" |
        sed -n 's/.*Shared library: \[\(libQt6[^]]*\.so\.6\)\].*/\1/p'
    done | LC_ALL=C sort -u
  )
  ((${#qt_libraries[@]} > 0))

  qt_version=$(qmake6 -query QT_VERSION)
  build_packages=(
    binutils cmake gcc gcc-libs glibc layer-shell-qt ninja nodejs npm
    qt6-base qt6-declarative qt6-shadertools qt6-svg qt6-tools qt6-wayland
    qtkeychain-qt6 syntax-highlighting wayland-protocols
  )
  cmake_flags=(
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR:STRING=lib
    -DCMAKE_INSTALL_LIBEXECDIR=libexec
    -DCMAKE_INSTALL_DATADIR=share
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -DBUILD_TESTS=OFF
    -DLTO=OFF
    -DIGNORE_CCACHE=ON
    -DINSTALL_NODE_MODULES=ON
    -DTYPESCRIPT_EXTENSIONS=ON
    -DVICINAE_NODE_RUNTIME_DOWNLOAD=OFF
    -DQT_QML_NO_CACHEGEN=ON
    -DINSTALL_MODULES_LOAD_CONFIG=OFF
    -DUSE_SYSTEM_CMARK_GFM=OFF
    -DUSE_SYSTEM_GLAZE=OFF
    -DFETCHCONTENT_SOURCE_DIR_GLAZE='<srcdir>/glaze-b518eec7a22e56ffa238b072c07f47efa7cea97f'
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
    -DUSE_SYSTEM_KF6=ON
    -DUSE_SYSTEM_QT_KEYCHAIN=ON
    -DUSE_SYSTEM_LAYER_SHELL=ON
    -DVICINAE_GIT_TAG=v0.25.0
    -DVICINAE_GIT_COMMIT_HASH=7e13b3f54
    -DVICINAE_PROVENANCE=arch_source
  )

  manifest_arguments=(
    --arg packageVersion "$pkgver-$pkgrel"
    --arg qtVersion "$qt_version"
    --arg sourceSha256 31480daaeda83a943c8cf2f96ea3d86580c30fbca225b6d31c021b80f5b56ee2
    --arg glazeSha256 0d108903feb443df316fb53eaec2fd6c1c6d96b368562ad830debc5c6c29c304
    --arg apiLockSha256 "$_npm_lock_api"
    --arg managerLockSha256 "$_npm_lock_extension_manager"
    --arg compatLockSha256 "$_npm_lock_raycast_compat"
    --argjson cmakeFlags "$(printf '%s\n' "${cmake_flags[@]}" | jq -Rsc 'split("\n")[:-1]')"
  )
  packages_json='{}'
  for package_name in "${build_packages[@]}"; do
    package_version=$(pacman -Q "$package_name" | cut -d' ' -f2-)
    packages_json=$(jq -cn \
      --argjson current "$packages_json" \
      --arg name "$package_name" \
      --arg version "$package_version" \
      '$current + {($name): $version}')
  done
  libraries_json='{}'
  for needed in "${qt_libraries[@]}"; do
    resolved=$(readlink -f -- "/usr/lib/$needed")
    [[ $resolved == /usr/lib/* && -f $resolved ]]
    build_id=$(readelf -n "$resolved" |
      sed -n 's/^[[:space:]]*Build ID: //p' | head -n 1)
    library_hash=$(sha256sum -- "$resolved")
    library_hash=${library_hash%% *}
    libraries_json=$(jq -cn \
      --argjson current "$libraries_json" \
      --arg path "/usr/lib/$needed" \
      --arg target "$(basename -- "$resolved")" \
      --arg buildId "$build_id" \
      --arg sha256 "$library_hash" \
      '$current + {($path): {target: $target, buildId: $buildId, sha256: $sha256}}')
  done
  executables_json='{}'
  for elf in "${executables[@]}"; do
    relative=${elf#"$pkgdir/"}
    build_id=$(readelf -n "$elf" |
      sed -n 's/^[[:space:]]*Build ID: //p' | head -n 1)
    interpreter=$(readelf -l "$elf" |
      sed -n 's/.*Requesting program interpreter: \([^]]*\).*/\1/p')
    mapfile -t needed_libraries < <(
      readelf -d "$elf" |
        sed -n 's/.*Shared library: \[\([^]]*\)\].*/\1/p' |
        LC_ALL=C sort -u
    )
    [[ $build_id =~ ^[0-9a-f]+$ && $interpreter == /lib64/ld-linux-x86-64.so.2 ]]
    ((${#needed_libraries[@]} > 0))
    needed_json=$(printf '%s\n' "${needed_libraries[@]}" |
      jq -Rsc 'split("\n")[:-1]')
    executables_json=$(jq -cn \
      --argjson current "$executables_json" \
      --arg path "$relative" \
      --arg buildId "$build_id" \
      --arg interpreter "$interpreter" \
      --argjson needed "$needed_json" \
      '$current + {($path): {buildId: $buildId, interpreter: $interpreter, needed: $needed}}')
  done
  jq -n \
    "${manifest_arguments[@]}" \
    --argjson packages "$packages_json" \
    --argjson qtLibraries "$libraries_json" \
    --argjson executables "$executables_json" \
    --arg qtBuildSnapshotSha256 "$qt_snapshot" \
    '{
      schemaVersion: 2,
      packageVersion: $packageVersion,
      source: {
        commit: "7e13b3f5450e9d91b09be2fec2f05c021c8ebb95",
        sha256: $sourceSha256,
        sourceDateEpoch: 1786353281
      },
      glaze: {
        commit: "b518eec7a22e56ffa238b072c07f47efa7cea97f",
        sha256: $glazeSha256
      },
      npmLocks: {
        "src/typescript/api/package-lock.json": $apiLockSha256,
        "src/typescript/extension-manager/package-lock.json": $managerLockSha256,
        "src/typescript/raycast-api-compat/package-lock.json": $compatLockSha256
      },
      cmakeFlags: $cmakeFlags,
      buildPackages: $packages,
      qtVersion: $qtVersion,
      qtLibraries: $qtLibraries,
      qtBuildSnapshotSha256: $qtBuildSnapshotSha256,
      executables: $executables,
      usesQtGuiPrivate: true,
      qmlCachegen: false
    }' >build-environment.json
  install -Dm644 build-environment.json \
    "$pkgdir/usr/share/vicinae/build-environment.json"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/vicinae-bin/LICENSE"
  install -Dm644 \
    cmark-gfm-COPYING kirigami-wheelhandler-COPYING vicinae-server-LICENSE \
    glaze-LICENSE react-LICENSE pugixml-LICENSE sqlcipher-LICENSE \
    tomlplusplus-LICENSE zip-LICENSE miniz-LICENSE CLI11-LICENSE rang-LICENSE \
    fzf-LICENSE emoji-segmenter-LICENSE unicode-data-LICENSE geist-mono-OFL \
    outfit-OFL noto-sans-math-OFL noto-sans-symbols-OFL devicon-LICENSE \
    wayland-protocols-COPYING \
    -t "$pkgdir/usr/share/licenses/vicinae-bin/bundled"

  [[ ! -e $pkgdir/usr/lib/modules-load.d/vicinae.conf ]]
  [[ ! -e $pkgdir/opt/vicinae ]]
  if find "$pkgdir" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
    return 1
  fi
  if find "$pkgdir" -mindepth 1 \( -type d -o -type f \) -perm /0022 \
    -print -quit | grep -q .; then
    return 1
  fi
  if find "$pkgdir" -type f -perm /6000 -print -quit | grep -q .; then
    return 1
  fi
  ! getcap -r "$pkgdir" 2>/dev/null | grep -q .

  while IFS= read -r -d '' entry; do
    [[ ! -L $entry && ( -d $entry || -f $entry ) ]] || return 1
    [[ $(stat -c '%U:%G' "$entry") == root:root ]] || return 1
    mode=$(stat -c '%a' "$entry") || return 1
    if [[ -d $entry ]]; then
      [[ $mode == 755 ]]
    elif [[ $entry == "$pkgdir/usr/bin/vicinae" || \
      $entry == "$pkgdir/usr/libexec/vicinae/"* && \
      $entry != *.conf ]]; then
      [[ $mode == 755 ]]
    else
      [[ $mode == 644 ]]
    fi
  done < <(find "$pkgdir" -mindepth 1 -print0)
}
