diff --git a/src/server/tests/clipboard/mime-data-from-selection.cpp b/src/server/tests/clipboard/mime-data-from-selection.cpp
new file mode 100644
index 0000000..5c62bfa
--- /dev/null
+++ b/src/server/tests/clipboard/mime-data-from-selection.cpp
@@ -0,0 +1,118 @@
+#include "services/clipboard/clipboard-mime.hpp"
+
+#include <QByteArray>
+#include <QMimeData>
+#include <QString>
+#include <QUrl>
+
+#include <iostream>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace {
+
+int failures = 0;
+
+void expect(bool condition, std::string_view message) {
+  if (condition) return;
+  std::cerr << "FAIL: " << message << '\n';
+  ++failures;
+}
+
+void expectOffer(const QMimeData &data, const QString &mimeType, const QByteArray &payload,
+                 std::string_view label) {
+  expect(data.hasFormat(mimeType), std::string(label) + " MIME is advertised");
+  expect(data.data(mimeType) == payload, std::string(label) + " payload is exact");
+}
+
+void verifyRichSelection(std::vector<ClipboardDataOffer> offers, std::string_view label) {
+  const QByteArray png{"\x89PNG\r\n\x1a\nrich-image", 18};
+  const QByteArray html{"<p><b>Rich</b> clipboard</p>"};
+  const QByteArray plain{"Rich clipboard"};
+  auto data = Clipboard::mimeDataFromSelection(ClipboardSelection{.offers = std::move(offers)});
+
+  expectOffer(*data, QStringLiteral("image/png"), png, std::string(label) + " image");
+  expectOffer(*data, QStringLiteral("text/html"), html, std::string(label) + " HTML");
+  expectOffer(*data, QStringLiteral("text/plain"), plain, std::string(label) + " plain text");
+  expect(data->text() == QString::fromUtf8(plain), std::string(label) + " plain view is preferred");
+  expect(data->html() == QString::fromUtf8(html), std::string(label) + " HTML view is preserved");
+}
+
+} // namespace
+
+int main() {
+  const QByteArray png{"\x89PNG\r\n\x1a\nrich-image", 18};
+  const QByteArray html{"<p><b>Rich</b> clipboard</p>"};
+  const QByteArray plain{"Rich clipboard"};
+
+  verifyRichSelection(
+      {
+          {.mimeType = QStringLiteral("image/png"), .data = png},
+          {.mimeType = QStringLiteral("text/html"), .data = html},
+          {.mimeType = QStringLiteral("text/plain"), .data = plain},
+      },
+      "rich forward");
+  verifyRichSelection(
+      {
+          {.mimeType = QStringLiteral("text/plain"), .data = plain},
+          {.mimeType = QStringLiteral("text/html"), .data = html},
+          {.mimeType = QStringLiteral("image/png"), .data = png},
+      },
+      "rich reverse");
+
+  {
+    const QByteArray charsetPlain{"charset-aware text"};
+    auto data = Clipboard::mimeDataFromSelection(ClipboardSelection{.offers = {
+        {.mimeType = QStringLiteral("text/html"), .data = html},
+        {.mimeType = QStringLiteral("text/plain;charset=utf-8"), .data = charsetPlain},
+    }});
+    expectOffer(*data, QStringLiteral("text/plain;charset=utf-8"), charsetPlain,
+                "charset plain");
+    expectOffer(*data, QStringLiteral("text/html"), html, "charset HTML");
+    expectOffer(*data, QStringLiteral("text/plain"), charsetPlain, "charset canonical plain");
+    expect(data->text() == QString::fromUtf8(charsetPlain),
+           "charset plain supplies the compatibility view");
+  }
+
+  const QByteArray uriPayload{"file:///tmp/first.txt\r\nfile:///tmp/second.txt"};
+  {
+    auto data = Clipboard::mimeDataFromSelection(ClipboardSelection{.offers = {
+        {.mimeType = QStringLiteral("text/uri-list"), .data = uriPayload},
+    }});
+    expect(data->hasFormat(QStringLiteral("text/uri-list")), "URI-only MIME is advertised");
+    expect(!data->hasFormat(QStringLiteral("text/plain")),
+           "URI-only selection does not synthesize plain text");
+    expect(data->urls() == QList<QUrl>{QUrl::fromLocalFile(QStringLiteral("/tmp/first.txt")),
+                                      QUrl::fromLocalFile(QStringLiteral("/tmp/second.txt"))},
+           "URI-only selection keeps parsed URLs");
+  }
+
+  {
+    auto data = Clipboard::mimeDataFromSelection(ClipboardSelection{.offers = {
+        {.mimeType = QStringLiteral("text/uri-list"), .data = uriPayload},
+        {.mimeType = QStringLiteral("text/plain"), .data = plain},
+    }});
+    expect(data->hasFormat(QStringLiteral("text/uri-list")),
+           "URI plus plain advertises the URI MIME");
+    expectOffer(*data, QStringLiteral("text/plain"), plain, "URI plus plain text");
+    expect(data->text() == QString::fromUtf8(plain), "URI plus plain keeps the plain view");
+  }
+
+  {
+    const QByteArray x11Text{"X11 compatibility text"};
+    auto data = Clipboard::mimeDataFromSelection(ClipboardSelection{.offers = {
+        {.mimeType = QStringLiteral("UTF8_STRING"), .data = x11Text},
+    }});
+    expectOffer(*data, QStringLiteral("UTF8_STRING"), x11Text, "X11 target");
+    expectOffer(*data, QStringLiteral("text/plain"), x11Text, "X11 canonical plain");
+    expect(data->text() == QString::fromUtf8(x11Text), "X11 target supplies the plain view");
+  }
+
+  if (failures != 0) {
+    std::cerr << failures << " clipboard MIME regression check(s) failed\n";
+    return 1;
+  }
+  std::cout << "Vicinae clipboard MIME preservation tests passed.\n";
+  return 0;
+}
