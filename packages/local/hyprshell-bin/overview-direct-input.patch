+#[derive(Debug, Eq, PartialEq)]
+enum DirectInputAction {
+    Switch(Direction, bool),
+    Close(bool),
+}
+
+fn direct_input_action(
+    key: gdk::Key,
+    modifiers: ModifierType,
+    launch_modifier: Modifier,
+) -> Option<DirectInputAction> {
+    let configured_modifier = match launch_modifier {
+        Modifier::Ctrl => modifiers == ModifierType::CONTROL_MASK,
+        Modifier::Alt => modifiers == ModifierType::ALT_MASK,
+        Modifier::Super => modifiers == ModifierType::SUPER_MASK,
+        Modifier::None => false,
+    };
+    match (configured_modifier, key) {
+        (_, gdk::Key::Escape) => Some(DirectInputAction::Close(false)),
+        (_, gdk::Key::Tab) => Some(DirectInputAction::Switch(Direction::Right, false)),
+        (_, gdk::Key::ISO_Left_Tab | gdk::Key::grave | gdk::Key::dead_grave) => {
+            Some(DirectInputAction::Switch(Direction::Left, false))
+        }
+        (true, gdk::Key::h) => Some(DirectInputAction::Switch(Direction::Left, true)),
+        (true, gdk::Key::l) => Some(DirectInputAction::Switch(Direction::Right, true)),
+        (_, gdk::Key::Left) => Some(DirectInputAction::Switch(Direction::Left, true)),
+        (_, gdk::Key::Right) => Some(DirectInputAction::Switch(Direction::Right, true)),
+        (_, gdk::Key::Up) | (true, gdk::Key::k) => {
+            Some(DirectInputAction::Switch(Direction::Up, true))
+        }
+        (_, gdk::Key::Down) | (true, gdk::Key::j) => {
+            Some(DirectInputAction::Switch(Direction::Down, true))
+        }
+        (_, gdk::Key::Return) => Some(DirectInputAction::Close(true)),
+        _ => None,
+    }
+}
+
+fn handle_direct_input(
+    key: gdk::Key,
+    modifiers: ModifierType,
+    launch_modifier: Modifier,
+    sender: &ComponentSender<OverviewWindow>,
+) -> glib::Propagation {
+    let Some(action) = direct_input_action(key, modifiers, launch_modifier) else {
+        return glib::Propagation::Proceed;
+    };
+    let output = match action {
+        DirectInputAction::Switch(direction, workspace) => {
+            OverviewWindowOutput::Switch(direction, workspace)
+        }
+        DirectInputAction::Close(do_switch) => OverviewWindowOutput::Close(do_switch),
+    };
+    let _ = sender.output(output);
+    glib::Propagation::Stop
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn overview_direct_input_preserves_launcher_navigation_contract() {
+        let none = ModifierType::empty();
+        assert_eq!(
+            direct_input_action(gdk::Key::Tab, none, Modifier::Ctrl),
+            Some(DirectInputAction::Switch(Direction::Right, false))
+        );
+        assert_eq!(
+            direct_input_action(gdk::Key::ISO_Left_Tab, none, Modifier::Ctrl),
+            Some(DirectInputAction::Switch(Direction::Left, false))
+        );
+        assert_eq!(
+            direct_input_action(gdk::Key::Right, none, Modifier::Ctrl),
+            Some(DirectInputAction::Switch(Direction::Right, true))
+        );
+        assert_eq!(
+            direct_input_action(gdk::Key::Return, none, Modifier::Ctrl),
+            Some(DirectInputAction::Close(true))
+        );
+        assert_eq!(
+            direct_input_action(gdk::Key::Escape, none, Modifier::Ctrl),
+            Some(DirectInputAction::Close(false))
+        );
+        assert_eq!(direct_input_action(gdk::Key::l, none, Modifier::Ctrl), None);
+        assert_eq!(
+            direct_input_action(gdk::Key::l, ModifierType::CONTROL_MASK, Modifier::Ctrl,),
+            Some(DirectInputAction::Switch(Direction::Right, true))
+        );
+    }
+}
