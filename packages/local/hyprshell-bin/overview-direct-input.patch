+fn uses_direct_overview_input(overview: &config_lib::Overview) -> bool {
+    let plugins = &overview.launcher.plugins;
+    !overview.launcher.show_when_empty
+        && plugins.applications.is_none()
+        && plugins.terminal.is_none()
+        && plugins.shell.is_none()
+        && plugins.websearch.is_none()
+        && plugins.calc.is_none()
+        && plugins.path.is_none()
+        && plugins.actions.is_none()
+}
