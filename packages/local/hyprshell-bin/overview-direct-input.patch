 pub fn configure_wm_initial() {
+    // A topology-owning harness must be able to start Hyprshell without its
+    // initial full compositor reload restoring wildcard monitor rules. The
+    // existing no-listeners mode already promises an inert external-policy
+    // boundary, so extend that contract to the one eager reload as well.
+    if std::env::var_os("HYPRSHELL_NO_LISTENERS").is_some() {
+        debug!(
+            "skipping initial hyprland config reload while listeners are disabled"
+        );
+        return;
+    }
     exec_lib::reload_hyprland_config()
         .context("Failed to reload hyprland config")
         .warn_details("unable to reload hyprland config");
 }
