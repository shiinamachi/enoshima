+    fn direct_input_requires_a_nonvisual_controller_only_launcher() {
+        let mut overview = config_lib::Overview::default();
+        overview.launcher.show_when_empty = false;
+        overview.launcher.plugins.applications = None;
+        overview.launcher.plugins.terminal = None;
+        overview.launcher.plugins.shell = None;
+        overview.launcher.plugins.websearch = None;
+        overview.launcher.plugins.calc = None;
+        overview.launcher.plugins.path = None;
+        overview.launcher.plugins.actions = None;
+        assert!(uses_direct_overview_input(&overview));
+
+        overview.launcher.show_when_empty = true;
+        assert!(!uses_direct_overview_input(&overview));
+    }
+}
