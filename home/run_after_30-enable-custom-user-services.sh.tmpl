#!/usr/bin/env bash
set -euo pipefail

units=(
  enoshima-windowd.service
  cyberdock.service
  cyberdock-event-bridge.service
  desktop-display-events.service
  desktop-power-verify.service
  kakaotalk-focus-guard.service
  xembed-sni-proxy.service
)

# Foreign packages were installed after the first Ansible convergence. Refresh the
# user manager before probing their newly installed packaged unit files.
systemctl --user daemon-reload

# This stable local source package is converged before chezmoi. Keep SKIP_LOCAL useful for
# diagnostics by enabling its packaged user unit only when installed.
if systemctl --user cat hyprshell.service >/dev/null 2>&1; then
  units+=(hyprshell.service)
fi

# Bootstrap alone owns Vicinae's mask, policy validation, ABI release, and
# declarative enable/start sequence. A standalone dotfile apply must not change
# that service state in either direction.

# The custom Quickshell launcher now shares Cyberdock's process and design
# tokens. Retire the old daemon so it cannot consume memory or race for focus.
systemctl --user disable --now hyprlauncher.service 2>/dev/null || true
rm -f -- \
  "$HOME/.config/systemd/user/default.target.wants/hyprlauncher.service" \
  "$HOME/.config/systemd/user/graphical-session.target.wants/hyprlauncher.service"

# Hyprbars used to add the same compositor titlebar to every client. Retire
# that optional plugin; the managed Enoshima fork is positive-allowlist only.
systemctl --user disable --now hyprbars-check.service 2>/dev/null || true
rm -f -- \
  "$HOME/.config/systemd/user/hyprbars-check.service" \
  "$HOME/.local/bin/hyprbars-green" \
  "$HOME/.local/bin/hyprbars-setup"

hyprbars_state=${XDG_STATE_HOME:-$HOME/.local/state}/hyprbars
if command -v hyprpm >/dev/null 2>&1 &&
  /usr/bin/sudo -n -v >/dev/null 2>&1; then
  hyprpm disable hyprbars >/dev/null 2>&1 || true
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hyprpm reload >/dev/null 2>&1 || true
    if command -v enoshima-decoration-load >/dev/null 2>&1; then
      enoshima-decoration-load >/dev/null 2>&1 ||
        hyprctl reload config-only >/dev/null 2>&1 || true
    else
      hyprctl reload config-only >/dev/null 2>&1 || true
    fi
  fi
fi
rm -f -- "$hyprbars_state/hyprland-abi" "$hyprbars_state/setup.lock"
rmdir -- "$hyprbars_state" 2>/dev/null || true

configuration_consumers=(
  hypridle.service
  hyprpaper.service
  swaync.service
  waybar.service
)

systemctl --user enable "${units[@]}"

if systemctl --user --quiet is-active graphical-session.target; then
  # Chezmoi runs after Ansible has started the existing user units. Refresh
  # every long-running consumer whose configuration was just deployed.
  # Bootstrap owns Vicinae's fail-closed guard and service convergence. Never
  # start or restart it from chezmoi before bootstrap validates privacy, ABI,
  # and effective service policy.
  restart_units=()
  for unit in "${units[@]}"; do
    [[ $unit == vicinae.service ]] || restart_units+=("$unit")
  done
  systemctl --user restart "${restart_units[@]}" "${configuration_consumers[@]}"
fi
