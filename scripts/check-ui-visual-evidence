#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
python3 \
  "$repo_root/.agents/skills/enoshima-concept-art/scripts/validate-concept-manifest" \
  --require-evidence "$repo_root/docs/ui-surfaces.yaml"
python3 "$repo_root/scripts/ui-capture/import-vm-run" \
  --repo-root "$repo_root" --validate-existing >/dev/null
